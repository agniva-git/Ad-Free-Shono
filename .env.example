# AdFreeShono configuration. Copy this file to .env and edit it.
# The app refuses to start while the secret key or the first admin password are placeholders.

# --- Hosting (docker compose) ---
# Your domain name, e.g. music.example.com or myname.duckdns.org
DOMAIN=your-domain-here

# --- Accounts ---
# The first admin account is created from these when the app starts for the first time.
# After that, add friends from the Admin page (or scripts/manage_users.py); changing
# ADMIN_PASSWORD later does nothing (change it from the Account page instead).
ADMIN_USERNAME=admin
# 10+ characters, your own. A few random words works well.
ADMIN_PASSWORD=change-me

# 32+ random characters. Signs login cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-the-generated-value

# --- Running it directly on your own PC (not needed for docker compose) ---
# HOST=127.0.0.1 allows this PC only; 0.0.0.0 lets other devices connect.
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Storage (relative paths are relative to the project folder)
DATABASE_URL=sqlite:///./data/music.db
MUSIC_DIR=./data/media/audio
ARTWORK_DIR=./data/media/artwork

# Upload limits, in megabytes
MAX_UPLOAD_MB=500        # largest single file
MEMBER_QUOTA_MB=5000     # total each friend account may upload (the admin is unlimited)
