# Personal Music Cloud Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database (defaults to local SQLite inside data/)
DATABASE_URL=sqlite:///./data/music.db

# Storage Directories (Relative to project root or absolute paths)
MUSIC_DIR=./data/media/audio
ARTWORK_DIR=./data/media/artwork

# Security & CORS (Allow all for local home Wi-Fi access)
ALLOWED_ORIGINS=*
SECRET_KEY=change-this-in-production-random-secret-key-adfree
