# AdFreeShono configuration. Copy this file to .env and edit it.

# --- Hosting ---
# Your domain name, e.g. music.example.com or myname.duckdns.org
DOMAIN=your-domain-here

# --- First-time Admin Setup ---
# These are used ONCE on first launch to create the admin account.
# After the admin exists, you can remove or leave these — they are ignored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Security ---
# 32+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-the-generated-value

# --- Server ---
# HOST=127.0.0.1 allows this PC only; 0.0.0.0 lets other devices connect.
HOST=0.0.0.0
PORT=8000
DEBUG=False

# --- Storage (relative paths are relative to the project folder) ---
DATABASE_URL=sqlite:///./data/music.db
MUSIC_DIR=./data/media/audio
ARTWORK_DIR=./data/media/artwork

# --- Limits ---
# Largest single upload, in megabytes
MAX_UPLOAD_MB=500
